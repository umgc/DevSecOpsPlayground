@using System.Diagnostics
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Graph
@using Microsoft.Identity.Web
@using Microsoft.AspNetCore.Http
@attribute [Authorize]
@attribute [AuthorizeForScopes(ScopeKeySection = "Graph:Scopes")]
@inject Microsoft.Graph.GraphServiceClient GraphClient
@inject ITokenAcquisition TokenAcquisition
@inject IHttpContextAccessor HttpContext
@inject MicrosoftIdentityConsentAndConditionalAccessHandler consentHandler
@inject NavigationManager NavigationManager

@page "/users"

<h1>Users</h1>
<AuthorizeView>
    <Authorized>
        @if (!isAdmin && !isStudent)
        {
            <h3>You must not be authorized to access this page.</h3>
            return;
        }

        @if (this.users?.Count > 0)
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Class#</th>
                        @if (isAdmin)
                        {
                            <th scope="col">User Group</th>
                        }
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in this.users)
                    {
                        if (!isAdmin && !string.Equals(user.Mail, this.consentHandler.User?.Identity?.Name))
                        {
                            continue;
                        }

                        <tr>
                            <td>
                                @(user.DisplayName)
                            </td>
                            <td>
                                @(user.Mail)
                            </td>
                            <td>
                                @(user.Department)
                            </td>
                            @if (isAdmin)
                            {
                                <td>
                                    @{
                                        string userGroups = GetUserGroups(user);
                                        if (string.IsNullOrEmpty(userGroups))
                                        {
                                            <button class="btn btn-primary" type="button" @onclick="@(async () => await AddGroupToUser(user))">Add Student Claim</button>
                                        }
                                        else
                                        {
                                            @userGroups
                                        }
                                    }
                                </td>
                            }
                            @if ((userDelete && !string.Equals(user.Mail, this.consentHandler.User?.Identity?.Name))
                           || (this.isStudent && string.Equals(user.Mail, this.consentHandler.User?.Identity?.Name)))
                            {
                                <td>
                                    <button class="btn btn-secondary" type="button" @onclick="() => DeleteUser(user)">Delete</button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (userInvite)
        {
            <div class="card">
                <div class="card-header">
                    Invite new user
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <EditForm Model="newUser" OnValidSubmit="InviteUser" Context="userAddContext">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <label for="email">
                                <span class="fas fa-empire"></span>Email address
                                <InputText @bind-Value="newUser.Mail" />
                            </label>
                            <button type="submit" class="btn btn-primary">Invite</button>
                        </EditForm>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        @if (!isLoaded)
        {
            <h3>Loading...</h3>
        }
        else
        {
            <h3 id="notAuthorized">You must not be authorized to access this page.</h3>
        }
    </NotAuthorized>
</AuthorizeView>

@code {

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    private User newUser { get; set; } = new User();

    private List<User>? users;

    private bool userInvite { get; set; }
    private bool userDelete { get; set; }

    private bool isAdmin { get; set; } = false;
    private bool isStudent { get; set; } = false;

    private bool isLoaded { get; set; } = false;

    // Runs when the page is accessed.
    protected override async Task OnInitializedAsync()
    {
        // Call to constructor of base
        await base.OnInitializedAsync();

        if (authenticationState == null)
        {
            return;
        }

        await authenticationState;

        if (consentHandler.User?.Identity == null)
        {
            isLoaded = true;
            return;
        }

        try
        {
            this.userInvite = consentHandler.User.CanInvite();
            this.userDelete = consentHandler.User.CanDelete();
            this.isAdmin = consentHandler.User.IsAdmin();
            this.isStudent = consentHandler.User.IsStudent();

            // If user can delete, they can also invite.
            if (userDelete)
            {
                userInvite = true;
            }
        }
        catch (Exception ex)
        {
            // No access but we will silently fail
        }

        try
        {
            this.users = await this.GetUsers();
        }
        catch (Exception ex)
        {
            consentHandler.HandleException(ex);
            await this.RefreshPage();
        }

        isLoaded = true;
    }

    private async Task<List<User>> GetUsers()
    {
        var users = await this.GraphClient.Users
        .Request()
        .Select("id,displayName,mail,department")
        .GetAsync();
        foreach (var user in users)
        {
            IUserMemberOfCollectionWithReferencesPage groups = await this.GraphClient
            .Users[user.Id]
            .MemberOf
            .Request()
            .GetAsync();
            user.MemberOf = groups;
        }

        return users.Cast<User>().ToList();
    }

    private async Task InviteUser()
    {
        // TODO: Invite user
        // Maybe confirmation modal? See https://github.com/Blazored/Modal
        if (userInvite)
        {
            var invitation = new Invitation
            {
                InvitedUserEmailAddress = this.newUser.Mail,
                InviteRedirectUrl = "https://umgc-cappms.azurewebsites.net",
                SendInvitationMessage = true,
            };

            var sentInvitation = await this.GraphClient.Invitations.Request().AddAsync(invitation);

            Debug.WriteLine($"Sent invitation:{sentInvitation.Status}");
        }

        newUser = new User();

        await this.RefreshPage();
    }

    private async Task DeleteUser(User user)
    {
        if (!this.isStudent && user.Mail.Equals(consentHandler.User.Identity?.Name, StringComparison.OrdinalIgnoreCase))
        {
            Debug.WriteLine($"Silly user tried to delete themselves. User:{user.Mail}");
            return;
        }

        if (this.isStudent && user.Mail.Equals(consentHandler.User.Identity?.Name, StringComparison.OrdinalIgnoreCase))
        {
            await this.GraphClient.Users[user.Id].Request().DeleteAsync();
            Debug.WriteLine($"Student {user.UserPrincipalName} has removed themselves.");
            NavigationManager.NavigateTo("MicrosoftIdentity/Account/SignOut");
            return;
        }

        if (userDelete)
        {
            Debug.WriteLine($"User {user.UserPrincipalName} has been deleted!");
            await this.GraphClient.Users[user.Id].Request().DeleteAsync();
        }

        await this.RefreshPage();
    }

    private async Task AddGroupToUser(User user)
    {
        if (user.IsStudent())
        {
            Debug.WriteLine($"Student {user.DisplayName} is already a memeber.");
            return;
        }

        try
        {
            var directoryObject = new DirectoryObject
                {
                    Id = user.Id
                };

            await GraphClient.Groups[UserExtensions.Student].Members.References.Request().AddAsync(directoryObject);
            Debug.WriteLine($"User {user.DisplayName} added to group {UserExtensions.Student}");
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Error adding user to group: {ex.Message}");
        }

        await RefreshPage();
    }

    private async Task RefreshPage()
    {
        await this.InvokeAsync( async () =>
        {
            await Task.Delay(350);
            this.StateHasChanged();
        });
    }

    private string GetUserGroups(User user)
    {
        return string.Join(",", user.MemberOf.Select(g =>
            {
                if (g is Group group)
                {
                    return group.DisplayName;
                }

                if (g is DirectoryRole role)
                {
                    return role.DisplayName;
                }

                return string.Empty;
            }));
    }
}
