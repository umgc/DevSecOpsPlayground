<EditForm Model="@review" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <AntiforgeryToken />

    <div class="card mt-2">
        <h5 class="card-header umgcHeader"> Student to be Evaluated</h5>
        <div class="card-body">
            <label class="form-label">
                Week:*
                <InputSelect id="weekSelected" @bind-Value="ReviewWeek" class="form-control">
                    <option value="" disabled selected>-- Select Week --</option>
                    @foreach (var week in DBOperationsService.GetWeeks())
                    {
                        <option Value="@week">@week</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => review.Week)" />
            </label>
            <label class="form-label">
                Evaluated Team Member:*
                <InputSelect id="studentSelected" @bind-Value="StudentId" class="form-control" @onkeydown="ClearMessage">
                    <option value="" disabled selected>-- Select Student --</option>
                    @foreach (Student student in studentsToReview)
                    {
                        <option Value="@student.StudentId">@student.LastName, @student.FirstName</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => review.ReviewedStudentId)" />
            </label>
            <label class="form-label" style="width: 90%;">
                Score (0 - 100, no contribution = 0, expected contribution = 85, beyond the call of duty = 90+):*
                <InputText id="score" @bind-Value="@review.Score" class="form-control" style="width: 10%" MaxLength="3" @onclick="ClearMessage" />
                <ValidationMessage For="@(() => review.Score)" />
            </label>

            <label style="width: 90%;" class="form-label">
                Comments:
                <textarea @bind="@review.Comments" class="form-control" rows="4" placeholder="Write your comments here!" @onclick="ClearMessage"></textarea>
            </label>
        </div>
    </div>

    <div style="margin-top: 10px; margin-bottom: 10px;">
        <h4 style="float: left; color: rgb(21, 142, 21)">@StatusMessage</h4>
        <input id="submitButton" type="submit" class="btn btn-primary" style="float: right;" value="Submit" />
    </div>
</EditForm>

<!-- Confirmation dialog box -->
<ConfirmationDialogBox @ref="confirmationDialogBox" ConfirmationButtonText="OK" ConfirmedChanged="CompleteSubmission" />


<br />

@if (completedReviews.Any())
{
    <!-- Table for displaying completed student evaluations -->
    <h5 class="card-header entries">Completed Evaluations</h5>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Week</th>
                    <th>Evaluated Team Member</th>
                    <th>Score</th>
                    <th>Comments</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var review in completedReviews)
                {
                    <tr>
                        <td>@review.Week</td>
                        <td>@review.RatedStudent</td>
                        <td>@review.Score</td>
                        <td>@review.Comments</td>
                        <td><span class="oi oi-delete" @onclick="() => DeleteReview(review)"></span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {

    private ConfirmationDialogBox confirmationDialogBox = new ConfirmationDialogBox();
    private List<Student> studentsToReview = new List<Student>();
    private List<Review> completedReviews = [];
    private Student loggedInStudent = new Student();
    private int studentId = -1;
    private int StudentId
    {
        get => studentId;
        set
        {
            this.studentId = value;
            OnStudentIdChangedAsync(value);
        }
    }
    private string reviewWeek = "One";
    private string ReviewWeek
    {
        get => reviewWeek;
        set
        {
            reviewWeek = value;
            _ = Task.Run(() => OnReviewWeekChangedAsync(this.reviewWeek));
        }
    }
    private Review review = new Review();
    private Review Review
    {
        get => review;
        set
        {
            review = value;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        IEnumerable<Student> students = await DBOperationsService.GetRecords<Student>();
        foreach (Student student in students)
        {
            if (student.Email == consentHandler.User.Identity.Name)
            {
                loggedInStudent = student;
                break;
            }
        }

        studentsToReview = students.Where(s => s.TeamId == loggedInStudent.TeamId && s.StudentId != loggedInStudent.StudentId).ToList();
        review.StudentReviewId = loggedInStudent.StudentId;
        this.OnReviewWeekChangedAsync(ReviewWeek);
        await base.OnInitializedAsync();
    }

    private async void OnReviewWeekChangedAsync(string week)
    {
        IEnumerable<Review> reviews = await DBOperationsService
        .GetRecords<Review>();
        completedReviews = reviews.Where(w => string.Equals(week, w.Week, StringComparison.OrdinalIgnoreCase) && w.StudentReviewId == this.loggedInStudent.StudentId)
        .ToList();

        _ = this.InvokeAsync(() => this.StateHasChanged());
    }

    private async void OnStudentIdChangedAsync(int studentId)
    {
        IEnumerable<Review> reviews = await DBOperationsService.GetRecords<Review>();
        Review? review = reviews.FirstOrDefault(r =>
            r.ReviewedStudentId == studentId &&
            r.Week == ReviewWeek &&
            r.StudentReviewId == this.loggedInStudent.StudentId);

        this.review = review ?? new Review();
    }

    // Method to clear the status message
    private void ClearMessage()
    {
        StatusMessage = ""; // Clear the status message
    }

    // Method to display a status message
    private void DisplayMessage(string message)
    {
        StatusMessage = message; // Set the status message
    }

    // Method to handle the focus event of form fields
    private void HandleFieldFocus()
    {
        ClearMessage(); // Clear the status message when a field gains focus
    }

    private async Task HandleValidSubmit()
    {
        await ShowConfirmationMessage("Are you sure you want to submit this evaluation?");
    }

    private async Task DeleteReview(Review review)
    {
        if (await DBOperationsService.RemoveRecord(review))
        {
            completedReviews = (await GetCompletedReviewsAsync()).ToList();
            this.StateHasChanged();
        }
    }

    private async Task<IEnumerable<Review>> GetCompletedReviewsAsync()
    {
        IEnumerable<Review> reviews = await DBOperationsService.GetRecords<Review>();
        return reviews.Where(r => r.StudentReviewId == loggedInStudent.StudentId);
    }

    private async Task CompleteSubmission()
    {
        if (review.ReviewedById < 0)
        {
            review.ReviewedById = loggedInStudent.StudentId;
        }

        if (review.ReviewedStudentId < 0)
        {
            review.ReviewedStudentId = StudentId;
        }

        if (await SubmitEvaluation())
        {
            // After successful submission, await the display of a confirmation message
            // The confirmation message indicates that the peer review submission was successful
            DisplayMessage("Submission was successful");

            completedReviews = (await GetCompletedReviewsAsync()).ToList(); // Add the completed review to the list of completed reviews)
            review = new Review()
            {
                ReviewedById = loggedInStudent.StudentId
            }; // Clear the form fields after submission

            await this.InvokeAsync(() => this.StateHasChanged()); // Notify the component that the state has changed
        }
    }

    private async Task ShowConfirmationMessage(string message) // Method declaration for showing a confirmation message asynchronously
    {
        confirmationDialogBox.ShowPopup(message);
        await Task.CompletedTask;
    }
}