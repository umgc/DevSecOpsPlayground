@using System.IO;
@using Microsoft.Extensions.FileProviders;
@using Microsoft.Identity.Web

@using CaPPMS.Pages.StudentReviews;
@inject DBOperationsService DBOperationsService
@inject MicrosoftIdentityConsentAndConditionalAccessHandler consentHandler
@inject NavigationManager NavigationManager

@namespace CaPPMS.Pages.StudentReviews

@attribute [Authorize]
@page "/ManageStudents"

<title>Manage Students</title>

<style>
    .card.classlist {
    height: 500px;
    }

    .card-body {
    max-height: calc(500px - 2.5rem); /* Set max height for the card body, considering the card header height */
    overflow-y: auto; /* Enable vertical scrolling */
    flex-wrap: wrap;
    justify-content: space-between;
    }

    .card-header {
    font-size: 25px;
    }

    .headerColor {
    background-color: rgb(30,30,120);
    color: white;
    }

    .entriesColor {
    background-color: rgb(51,16,90);
    color: white;
    }

    .short-search {
    width: 300px; /* Adjust as needed */
    }

    #clear-btn {
    margin-left: 5px;
    width: 110px;
    font-size: 14px;
    }

    .form-control {
    display: inline-block; /* Ensure buttons are displayed inline */
    }

    .editStudentContainer {
    display: flex;
    justify-content: center;
    }

    .custom-button {
    display: flex;
    float: right;
    align-items: center;
    justify-content: center;
    background-color: blue;
    color: white;
    cursor: pointer;
    position: relative;
    }

    .custom-button:hover {
    background-color: lightblue;
    }

    .custom-button input[type=file] {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    }
</style>

<AddNewCourse OnTableUpdated="() => Refresh(updateSelectedClass: true)" />

@if (availableClasses.Count() == 0 || !consentHandler.User.IsAdmin())
{
    <p>No classes available. Please add one.</p>
    return;
}

<div class="card">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Team</th>
                <th>Members</th>
            </tr>
        </thead>
        <tbody>

            @foreach (dynamic team in students
            .GroupBy(s => s.TeamName)
            .Where(g => g.Count() > 0)
            .Select(g => new { TeamName = g.Key, Count = g.Count(), Members = string.Join(",", g.Select(s => $"{s.FirstName} {s.LastName}")) })
            .OrderBy(item => item.TeamName))
            {
                <tr>
                    <td>@team.TeamName (@team.Count)</td>
                    <td>@team.Members</td>
                </tr>
            }
            <tr>
                <td colspan="2">Total Count:@students.Count</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="card classlist">
    <h5 class="card-header umgcHeader">
        Student Directory.  Class Context:
        <InputSelect @bind-Value="this.SelectedClass" class="form-control" style="width: 200px;" >
            <option disabled selected>-- Select Class --</option>

            @foreach (ClassInformation classInfo in availableClasses)
            {
                <option Value="@classInfo">@classInfo.Course - @classInfo.Cohort</option>
            }
        </InputSelect>
    </h5>
    <div class="form-group mt-2 mb-2">
        <input id="filterInput" type="text" class="form-control short-search" placeholder="Search Student..." />
        <span class="btn btn-primary">Upload Class CSV:&nbsp;<InputFile OnChange="HandleFileSelection" />
        </span>
    </div>
    <div id="tableContainer" >
        <table id="manageStudentsTable" class="table table-bordered table-striped table-hover scrollTable">
            <thead class="fixedHeader">
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>GitHub</th>
                    <th>Assigned Team</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in students)
                {
                    <tr>
                        <td><InputText DisplayName="First Name" @bind-Value="student.FirstName" /></td>
                        <td><InputText DisplayName="Last Name" @bind-Value="student.LastName" /></td>
                        <td><InputText DisplayName="Student Email" @bind-Value="student.Email" /></td>
                        <td><InputText DisplayName="GitHub Account" @bind-Value="student.GitHub" /></td>
                        <td>
                            <InputSelect class="form-control" @bind-Value="student.TeamId">
                                <option disabled selected>-- Select Team --</option>
                                @foreach (var team in teams)
                                {
                                    <option Value="@team.TeamId">@team.Name</option>
                                }
                            </InputSelect>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5"><button class="btn btn-primary" @onclick="UpdateStudents">Save Changes</button></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
<div>
    <!-- Keep some buffer at the bottom -->
    <br />
    <br />
    <br />
</div>

@code {
    private IEnumerable<ClassInformation> availableClasses = [];
    private string searchTeam = string.Empty;
    private bool isAvailableClassLoaded => availableClasses.Any(c => DateTime.Now.Month >= c.StartDate.Month && DateTime.Now.Month <= c.EndDate.Month);
    private ClassInformation selectedClass = new ClassInformation();
    private IEnumerable<Team> teams = new List<Team>();
    private bool hidePanel = true;
    private List<Student> students = [];
    private ClassInformation SelectedClass
    {
        get
        {
            return this.selectedClass;
        }
        set
        {
            this.selectedClass = value;
            ClassChanged(this.selectedClass);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Refresh(updateSelectedClass: true);
    }

    private async Task Refresh(bool updateSelectedClass)
    {
        availableClasses = await DBOperationsService.GetRecords<ClassInformation>();
        if (updateSelectedClass && availableClasses.Any())
        {
            this.SelectedClass = availableClasses.First();
        }

        await this.InvokeAsync(async () =>
        {
            this.StateHasChanged();
        });
    }

    public async Task UpdateStudents()
    {
        foreach (Student student in students)
        {
            if (student.ClassId < 0 || student.TeamId < 0)
            {
                continue;
            }

            await DBOperationsService.UpdateRecord(student);
        }

        await Task.Delay(500);
        NavigationManager.Refresh();
    }

    public async void ClassChanged(ClassInformation classInformation)
    {
        students = (await DBOperationsService.GetRecords<Student>())
        .OrderBy(s => s.FirstName)
        .Where(s => s.ClassId == selectedClass.ClassId).ToList();
        teams = (await DBOperationsService.GetRecords<Team>()).Where(t => t.ClassId == selectedClass.ClassId).ToList();

        // Assign the team to the student.
        foreach (Student student in students)
        {
            Team? team = teams.FirstOrDefault(t => t.TeamId == student.TeamId);
            if (team == null)
            {
                continue;
            }

            student.SetTeam(team);
        }

        this.StateHasChanged();
    }

    public async Task TeamChanged(long teamId, Student student)
    {
        Team? team = teams.FirstOrDefault(t => t.TeamId == teamId);
        if (team == null)
        {
            return;
        }

        Team? team1 = (await DBOperationsService.GetRecords<Team>(team.TeamId)).FirstOrDefault();
        if (team1 == null)
        {
            return;
        }

        student.SetTeam(team1);
        await DBOperationsService.UpdateTeamAssignmentAsync(student.TeamId, student.TeamId);
        await this.Refresh(updateSelectedClass: false);
    }

    private async Task HandleFileSelection(InputFileChangeEventArgs e)
    {
        try
        {
            var files = e.GetMultipleFiles();
            foreach (var file in e.GetMultipleFiles())
            {
                if (file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
                {
                    // Process CSV file
                    await ProcessStreamAsync(file.OpenReadStream(), file.Name);
                }
                else
                {
                    // Handle unsupported file types
                    Console.WriteLine($"Unsupported file type: {file.Name}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task ProcessStreamAsync(Stream stream, string fileName)
    {
        try
        {
            using (StreamReader reader = new StreamReader(stream))
            {
                string fileContent = await reader.ReadToEndAsync();

                // TODO: Add dropped records to another table for notification to user.
                List<Student> students = Student.ParseData(fileContent, selectedClass.ClassId, out _);
                var currentStudents = await DBOperationsService.GetRecords<Student>();
                foreach (Student student in students
                    .Where(s => !currentStudents
                        .Any(c => string.Equals(c.Email, s.Email, StringComparison.OrdinalIgnoreCase))))
                {
                    await DBOperationsService.AddRecord(student);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

        ClassChanged(this.selectedClass);
        this.StateHasChanged();
    }
}