@using Microsoft.AspNetCore.Components.Forms
@using CaPPMS.Pages.StudentReviews

@inject DBOperationsService DBOperationsService
@page "/StudentReviews/MyRatings"

<title>My Ratings</title>
@{
    // TODO: Remove style and use site.css
}
<style>
    .card.scores {
    height: 530px;
    }

    .card-header {
    color: white;
    font-size: 25px;
    }

    .headerColor {
    background-color: rgb(30,30,120);
    color: white;
    }

    .entriesColor {
    background-color: rgb(51,16,90);
    color: white;
    }

    .card-body {
    max-height: calc(520px - 2.5rem); /* Set max height for the card body, considering the card header height */
    overflow-y: auto; /* Enable vertical scrolling */
    flex-wrap: wrap;
    justify-content: space-between;
    }

    /* Style for the outer table */
    table.outerTable {
    border-collapse: collapse;
    border: 2px solid black; /* Add a border to the entire outer table */
    }

    /* Style for the outer table cells (except for the inner table) */
    table.outerTable td:not(.innerTable td) {
    border: 1px solid gray; /* Add a border to the outer table cells */
    padding: 10px; /* Add some padding for spacing */
    }

    /* Style for the inner table */
    table.innerTable {
    border-collapse: collapse;
    border: none; /* Remove borders from the inner table */
    }

    /* Style for the inner table cells (td) */
    table.innerTable td {
    padding: 5px; /* Add padding for spacing */
    }

    .form-group.mb-3 {
    margin-bottom: 10px; /* Adjust as needed */
    }

    .short-search {
    width: 300px; /* Adjust as needed */
    }

    #clear-btn {
    margin-left: 5px;
    width: 110px;
    font-size: 14px;
    }

    .form-control {
    display: inline-block; /* Ensure buttons are displayed inline */
    }
    #innerTable.table-striped > tbody > tr:nth-child(odd) > td,
    #innerTable.table-striped > tbody > tr:nth-child(odd) > th {
    background-color: lightgray;
    }
</style>

<div class="card scores mt-4">
    <h5 class="card-header headerColor">My Ratings</h5>
    <div id="tableContainer" class="card-body tableContainer" style="padding: 1px;">
        <table id="studentsTable" class="table table-hover">
            <thead>
                <tr>
                    <th style="width: 75px;">Average</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td valign="top">@studentScores[0].AverageScore</td>
                    <td>
                        <div id="tableContainer" class="card-body tableContainer" style="padding: 1px;">
                            <table id="studentsTable" class="table table-striped table-hover" border="1">
                                <thead>
                                    <tr class="entriesColor">
                                        <th style="width: 150px; background-color: lightgray;">Week</th>
                                        <th style="width: 75px; background-color: lightgray; ">Score</th>
                                        <th style="background-color: lightgray; ">Comments</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var scoreDetails in studentScores)
                                    {
                                        <tr>
                                            <td>@scoreDetails.Week</td>
                                            <td>@scoreDetails.Score</td>
                                            <td>@scoreDetails.Comment</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code
{
    private List<StudentScores> studentScores = [];

    protected override async Task OnInitializedAsync()
    {
        // TODO: Replace the hardcoded student ID with the actual student ID
        studentScores.AddRange(await DBOperationsService.RetrieveStudentScoresAsync(18));
        await base.OnInitializedAsync();
    }
}