@using CaPPMS.Pages.StudentReviews
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Identity.Web

@attribute [Authorize]
@page "/adminstudentreview"

@inject DBOperationsService DBOperationsService
@inject MicrosoftIdentityConsentAndConditionalAccessHandler consentHandler

<title>Student Scores</title>
<style>
    .card.scores {
        height: 530px;
    }

    .card-header {
        color: white;
        font-size: 25px;
    }

    .headerColor {
        background-color: rgb(30,30,120);
        color: white;
    }

    .headerColorStudentScore {
        background-color: darkred;
        color: white;
    }

    .entriesColor {
        background-color: rgb(51,16,90);
        color: white;
    }

    .entriesColorWeeklyRatings {
        background-color: darkred;
        color: white;
    }

    .card-body {
        max-height: calc(520px - 2.5rem);
        overflow-y: auto;
        flex-wrap: wrap;
        justify-content: space-between;
    }

    table.outerTable {
        border-collapse: collapse;
        border: 2px solid black;
    }

    table.outerTable td:not(.innerTable td) {
        border: 1px solid gray;
        padding: 10px;
    }

    table.innerTable {
        border-collapse: collapse;
        border: none;
    }

    table.innerTable td {
        padding: 5px;
    }

    .form-group.mb-3 {
        margin-bottom: 10px;
    }

    .short-search {
        width: 300px;
    }

    #clear-btn {
        margin-left: 5px;
        width: 110px;
        font-size: 14px;
    }

    .form-control {
        display: inline-block;
    }

    #innerTable.table-striped > tbody > tr:nth-child(odd) > td,
    #innerTable.table-striped > tbody > tr:nth-child(odd) > th {
        background-color: lightgray;
    }
</style>
<div class="card scores mt-4">
    <h5 class="card-header headerColorStudentScore">Student Scores</h5>
    <div class="form-group mb-3 m-lg-3" style="display: flex;">
        <input id="filterInput" type="text" class="form-control short-search" oninput="applyFilter()" placeholder="Search Student..." />
        <input id="clear-btn" class="btn btn-primary headerColor" style="margin-left: 5px" value="Clear Search" onclick="clearSearch()" />
        <hr />
        <hr />
    </div>
    <div id="tableContainer" class="card-body tableContainer" style="padding: 1px;">
        <table id="studentScoreTable" class="table table-striped table-hover scrollTable">
            <thead class="fixedHeader">
                <tr>
                    <th style="background-color: darkred; color: white;">Details</th>
                    <th style="background-color: darkred; color: white;">First Name</th>
                    <th style="background-color: darkred; color: white;">Last Name</th>
                    <th style="background-color: darkred; color: white;">Average Score</th>
                </tr>
            </thead>
            <tbody class="scrollContent">
                @foreach (var student in studentScores)
                {
                    if (student.StudentId != previousId)
                    {
                        // Retrieved data will have multiple rows for some students. We only want to show one row for each
                        // student at this point.
                        previousId = student.StudentId;

                        <tr>
                            <td><i class="oi oi-pencil" @onclick="() => EditStudent(student)"></i></td>
                            <td>@student.FirstName</td>
                            <td>@student.LastName</td>
                            <td>@student.AverageScore</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card mt-4" hidden="@(HidePanel)">
    <h5 class="card-header entriesColorWeeklyRatings">Weekly Ratings</h5>
    <div class="card-body">
        <table id="studentsTable" class="table table-hover" border="1">
            <thead>
                <tr>
                    <th style="width: 150px; background-color: darkred; color: white;">Student</th>
                    <th style="width: 75px; background-color: darkred; color: white;">Average</th>
                    <th style="background-color: darkred; color: white;">&nbsp;</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td valign="top">@selectedStudent.FullName</td>
                    <td valign="top">@selectedStudent.Average</td>
                    <td>
                        <table id="innerTable" class="table table-striped table-hover" border="1">
                            <thead>
                                <tr class="entriesColor">
                                    <th style="width: 150px; background-color: darkred; color: white;">Week</th>
                                    <th style="background-color: darkred; color: white;">Score</th>
                                    <th style="background-color: darkred; color: white;">Comments</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var scoreDetails in selectedStudent.WeeklyRating)
                                {
                                    <tr>
                                        <td>@scoreDetails.Item1</td>
                                        <td>@scoreDetails.Item2</td>
                                        <td>@scoreDetails.Item3</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </td>
                </tr>
            </tbody>
        </table>
        <div colspan="8" style="display: flex; justify-content: flex-end; float: left;">
            <button type="button" @onclick="CloseWindow" class="btn btn-outline-dark form-control" style="margin-top: 10px; width: 100px; margin-left: 5px;">Close</button>
        </div>
    </div>
</div>

@code
{
    private long previousId = 0;
    private SelectedStudent selectedStudent = new SelectedStudent();

    protected override async Task OnInitializedAsync()
    {
        studentScores.AddRange(await DBOperationsService.GetStudentScoresAsync());
        await base.OnInitializedAsync();
    }

    public List<StudentScores> studentScores = [];
    public bool HidePanel { get; set; } = true;

    public void EditStudent(StudentScores student)
    {
        var scoresAndComments = studentScores
            .Where(s => s.StudentId == student.StudentId)
            .Select(s => new Tuple<string, double, string>(s.Week, s.Score, string.Join("\n", s.Comments)))
            .ToList();

        selectedStudent = new SelectedStudent()
        {
            FirstName = student.FirstName,
            LastName = student.LastName,
            Average = student.AverageScore,
            WeeklyRating = scoresAndComments
        };

        HidePanel = false;
    }

    public string GetFullName(string firstName, string lastName)
    {
        return string.Concat(firstName, lastName);
    }

    public void CloseWindow()
    {
        HidePanel = true;
    }

    public class SelectedStudent
    {
        public SelectedStudent()
        {
            WeeklyRating = new List<Tuple<string, double, string>>();
        }

        public string FirstName { get; set; } = string.Empty;

        public string LastName { get; set; } = string.Empty;
        
        public string FullName => $"{FirstName.Trim()} {LastName.Trim()}";
        
        public double Score { get; set; }
        
        public List<Tuple<string, double, string>> WeeklyRating { get; set; }
        
        public double Average { get; set; }
        
        public string Comments { get; set; } = string.Empty;
    }
}