@using CaPPMS.Data
@using CaPPMS.Model
@inject ProjectManagerService ProjectManager

@page "/projectlist"

    <CascadingAuthenticationState>
        @{
            var ordered = ProjectManager.ProjectIdeas.Values
                .OrderBy(i => i.Status == "New" ? 0 : 1)
                .ThenBy(i => i.Status).ToList();
        }
        <ProjectTable DataSource="new List<ProjectInformation>(ordered)" CssClass="table border p-2" />
    </CascadingAuthenticationState>

@code {
}
