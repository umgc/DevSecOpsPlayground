@using CaPPMS.Data
@using CaPPMS.Model
@using CaPPMS.Attributes
@using MudBlazor
@namespace CaPPMS.Shared
@using System


@inject ProjectManagerService ProjectManager

<MudTable Items="PagedItems" Class="@CssClass" Dense="true">
    <HeaderContent>
        <MudTableRow>
            <MudTableTh Style="cursor:pointer" OnClick="() => SortByColumn(nameof(ProjectInformation.ProjectTitle))">
                Project Title
            </MudTableTh>
            <MudTableTh Style="cursor:pointer" OnClick="() => SortByColumn(nameof(ProjectInformation.ProjectDescription))">
                Project Description
            </MudTableTh>
            <MudTableTh Style="cursor:pointer" OnClick="() => SortByColumn(nameof(ProjectInformation.Status))">
                Status
            </MudTableTh>
        </MudTableRow>
    </HeaderContent>
    <RowTemplate Context="item">
        <MudTableRow>
            <MudTableTd>
                <button @onclick="() => ToggleCollapse(item)" class="btn btn-primary btn-sm">
                    @(IsCollapsed(item) ? "+" : "-")
                </button>
            </MudTableTd>
            <MudTableTd>@item.ProjectTitle</MudTableTd>
            <MudTableTd>@item.ProjectDescription</MudTableTd>
            <MudTableTd>@item.Status</MudTableTd>
        </MudTableRow>
    </RowTemplate>

</MudTable>

<div class="filter-container">
    <MudTextField T="string" @bind-Value="filter" Label="Filter projects" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
</div>
<div class="pagination">
    @if (TotalCount > 0)
    {
        <button @onclick="@PreviousPage">‹ Prev</button>
        <span>Showing @(((page - 1) * pageSize + 1))–@(Math.Min(page * pageSize, TotalCount)) of @TotalCount items (@FilteredItems.Count() total)</span>
        <button @onclick="@NextPage" disabled="@(page >= PageCount)">Next ›</button>
    }
    else
    {
        <span>No results</span>
    }
</div>





@code {
    [Parameter]
    public IEnumerable<ProjectInformation> DataSource { get; set; } = Enumerable.Empty<ProjectInformation>();

    [Parameter]
    public string CssClass { get; set; } = "table border p-2";

    private string filter = string.Empty;
    private string sortColumn = nameof(ProjectInformation.ProjectTitle);
    private bool sortAscending = true;
    private int page = 1;
    private int pageSize = 10;
    private readonly HashSet<Guid> collapsedIds = new();

    private IEnumerable<ProjectInformation> SortedItems =>
        sortAscending
            ? DataSource.OrderBy(p => GetSortValue(p, sortColumn))
            : DataSource.OrderByDescending(p => GetSortValue(p, sortColumn));

    private IEnumerable<ProjectInformation> FilteredItems =>
        string.IsNullOrWhiteSpace(filter)
            ? SortedItems
            : SortedItems.Where(p =>
                (p.ProjectTitle?.Contains(filter, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.ProjectDescription?.Contains(filter, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Status?.Contains(filter, StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<ProjectInformation> PagedItems =>
        FilteredItems.Skip((page - 1) * pageSize).Take(pageSize);

    private object? GetSortValue(ProjectInformation p, string column) => column switch
    {
        nameof(ProjectInformation.ProjectTitle) => (object?)(p.ProjectTitle ?? string.Empty),
        nameof(ProjectInformation.ProjectDescription) => (object?)(p.ProjectDescription ?? string.Empty),
        _ => (object?)(p.Status ?? string.Empty),
    };

    private void SortByColumn(string column)
    {
        if (column == sortColumn)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        page = 1;
    }

    private void ToggleCollapse(ProjectInformation idea)
    {
        if (idea is null) return;
        if (collapsedIds.Contains(idea.ProjectID))
        {
            collapsedIds.Remove(idea.ProjectID);
        }
        else
        {
            collapsedIds.Add(idea.ProjectID);
        }
    }

    private bool IsCollapsed(ProjectInformation idea) => idea is not null && collapsedIds.Contains(idea.ProjectID);

    private int TotalCount => FilteredItems.Count();
    private int PageCount => Math.Max(1, (int)Math.Ceiling((double)TotalCount / pageSize));

    private void PreviousPage()
    {
        if (page > 1)
        {
            --page;
            StateHasChanged();
        }
    }

    private void NextPage()
    {
        if (page < PageCount)
        {
            ++page;
            StateHasChanged();
        }
    }



}