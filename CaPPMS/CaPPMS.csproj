<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <UserSecretsId>aspnet-CaPPMS-A0D09EB7-68B3-478B-B4AD-61650E36F1C0</UserSecretsId>
    <WebProject_DirectoryAccessLevelKey>0</WebProject_DirectoryAccessLevelKey>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <StartupObject>CaPPMS.Program</StartupObject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG</DefineConstants>
    <DocumentationFile></DocumentationFile>
    <Optimize>False</Optimize>
  </PropertyGroup>

  <PropertyGroup>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType></DebugType>
    <DefineConstants></DefineConstants>
    <Commandlineparameters></Commandlineparameters>
    <RunWithWarnings>true</RunWithWarnings>
    <NoWarn></NoWarn>
    <AllowUnsafeBlocks></AllowUnsafeBlocks>
    <CheckForOverflowUnderflow></CheckForOverflowUnderflow>
    <DebugType>portable</DebugType>
    <DefineConstants>TRACE;RELEASE;NET;NET8_0;NETCOREAPP</DefineConstants>
    <NoWarn>1701;1702</NoWarn>
    <Optimize>False</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="StudentReviews\**" />
    <Content Remove="StudentReviews\**" />
    <EmbeddedResource Remove="StudentReviews\**" />
    <None Remove="StudentReviews\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="SQLScripts\ReadStudentScoreByStudent.sql" />
    <None Remove="SQLScripts\ReadStudentScoreDetails.sql" />
    <None Remove="SQLScripts\ReadStudentScores.sql" />
    <None Remove="SQL_Creation\CaPPMS_Table_Generation.sql" />
    <None Remove="SQL_Creation\StudentDataBaseCreation.sql" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SQLScripts\ReadStudentScoreByStudent.sql" />
    <EmbeddedResource Include="SQLScripts\ReadStudentScores.sql" />
    <EmbeddedResource Include="SQLScripts\ReadStudentScoreDetails.sql" />
    <EmbeddedResource Include="SQLScripts\StudentDataBaseCreation.sql">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="SQL_Creation\CaPPMS_Table_Generation.sql">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

